# Domain Caddy requests a certificate for and serves the app on.
# Use a real DNS name in production (Caddy needs it for automatic HTTPS).
DOMAIN=localhost

# GitHub OAuth App credentials (https://github.com/settings/developers).
# Callback URL should be: https://<DOMAIN>/oauth2/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Random secret used to encrypt the oauth2-proxy session cookie.
# Generate one with: openssl rand -base64 32
OAUTH2_PROXY_COOKIE_SECRET=

# Backend database connection string.
DATABASE_URL=postgresql://user:password@localhost:5432/archstudio
